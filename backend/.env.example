PROJECT_NAME="ClassFlow AI API"
API_V1_PREFIX=/api
ENVIRONMENT=development

# PostgreSQL connection string (Desarrollo)
# Formato: postgresql+psycopg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/classflow_ai

# Base de datos PostgreSQL independiente para pruebas automatizadas (pytest)
TEST_DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/classflow_ai_test

# CORS allowed origins (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini AI Integration (CU05)
# Obtén tu API key en Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash


